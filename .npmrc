# Éviter les retéléchargements : privilégier le cache npm local
prefer-offline=true
# Ignorer les scripts postinstall lors des installs dans .output/server
ignore-scripts=false
# Forcer une structure node_modules à plat (comme npm) pour que le script
# prepare-tauri-runtime.ts puisse résoudre les dépendances correctement
node-linker=hoisted
